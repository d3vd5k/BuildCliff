# Supply credentials privately in the ignored .env file; never commit that file.
# Atlas connection string; no local MongoDB fallback is used.
MONGODB_URI=

# Leave blank to use deterministic explanations without provider requests.
AI_GATEWAY_API_KEY=
# Gateway model ID; no automatic model substitution.
AI_GATEWAY_MODEL=openai/gpt-5-nano

# Explanation requests have an 8000 ms deadline, including response body parsing.
# Tests/callers may inject options.timeoutMs; there is no timeout environment variable.
